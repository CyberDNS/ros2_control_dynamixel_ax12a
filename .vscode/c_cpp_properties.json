{
  "version": 4,
  "configurations": [
    {
      "name": "ROS2-Jazzy-Remote",
      "intelliSenseMode": "gcc-x64",
      "compilerPath": "/usr/bin/g++",
      "cppStandard": "c++17",
      "cStandard": "c17",
      "includePath": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/install/**/include",
        "/opt/ros/jazzy/include/**"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}/install",
          "/opt/ros/jazzy/include/**"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    }
  ]
}